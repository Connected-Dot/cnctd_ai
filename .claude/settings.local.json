{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(cargo:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(rustfmt:*)",
      "Write(*/docs/SESSION_*.md)",
      "Write(*/docs/POST_MORTEM_*.md)",
      "Task(session-summary-writer)",
      "Task(post-mortem-writer)",
      "Bash(gh repo list:*)",
      "Bash(gh auth:*)",
      "Bash(done)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
