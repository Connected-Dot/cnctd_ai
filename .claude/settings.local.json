{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(cargo:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(rustfmt:*)",
      "Write(*/docs/SESSION_*.md)",
      "Write(*/docs/POST_MORTEM_*.md)",
      "Task(session-summary-writer)",
      "Task(post-mortem-writer)",
      "Bash(gh repo list:*)",
      "Bash(gh auth:*)",
      "Bash(done)",
      "Bash(rustc:*)",
      "Bash(rustup show:*)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(grep:*)",
      "WebFetch(domain:platform.openai.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:docs.google.com)",
      "WebFetch(domain:docs.cloud.google.com)",
      "WebFetch(domain:discuss.ai.google.dev)",
      "WebFetch(domain:medium.com)",
      "Bash(find:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
